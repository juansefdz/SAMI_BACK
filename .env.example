# Copiar a .env (no se versiona) o exportar como variables de entorno
SPRING_PROFILES_ACTIVE=dev
DB_URL=jdbc:mysql://localhost:3306/sami?createDatabaseIfNotExist=true&serverTimezone=UTC
DB_USER=sami
DB_PASSWORD=sami
# openssl rand -base64 64
JWT_SECRET=
JWT_EXPIRATION=PT24H
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:8081
GOOGLE_MAPS_API_KEY=
# Primer administrador (opcional, solo si no existe ninguno)
SAMI_ADMIN_EMAIL=
SAMI_ADMIN_PASSWORD=
